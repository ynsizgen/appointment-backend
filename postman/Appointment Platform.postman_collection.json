    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Public application health endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Application is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verification Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/verify-email",
            "description": "Public HTML page used by the email verification link. The real token is supplied in the URL fragment by the browser."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verification Page Script",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/verify-email.js",
            "description": "Public JavaScript used by the verification page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Public registration/login endpoints plus session-protected account and logout endpoints. Postman manages JSESSIONID automatically.",
      "item": [
        {
          "name": "01 Get CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf",
            "description": "Creates/uses the current HTTP session and saves its CSRF token into collection variables. Run before registration, verification or login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const csrf = pm.response.json();",
                  "pm.test('CSRF response contains token and header name', () => {",
                  "  pm.expect(csrf.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(csrf.headerName).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('csrfToken', csrf.token);",
                  "pm.collectionVariables.set('csrfHeader', csrf.headerName);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Register Brand",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{brandEmail}}\",\n  \"password\": \"{{brandPassword}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"phone\": \"+905551112233\",\n  \"displayName\": \"Example Brand\",\n  \"address\": \"İstanbul, Türkiye\",\n  \"googleMapsUrl\": \"https://maps.google.com/example\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/registrations",
            "description": "Starts brand registration. Expected status: 202. Retrieve the verification token from the local Mailpit message and save it as verificationToken."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrfToken')) throw new Error('Run 01 Get CSRF first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "pm.test('Generic registration message is returned', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/verify-email",
            "description": "Completes email verification with the 43-character token extracted from the verification link. Expected status: 204."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrfToken')) throw new Error('Run 01 Get CSRF first.');",
                  "if (!pm.collectionVariables.get('verificationToken')) throw new Error('Set verificationToken from the verification email first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04 Brand Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{brandEmail}}\",\n  \"password\": \"{{brandPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in a verified brand account. Successful login rotates JSESSIONID and invalidates the old CSRF token. Run 06 Refresh CSRF next."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrfToken')) throw new Error('Run 01 Get CSRF first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const account = pm.response.json();",
                  "  pm.test('Role is BRAND', () => pm.expect(account.role).to.eql('BRAND'));",
                  "  if (account.brandId) pm.collectionVariables.set('brandId', account.brandId);",
                  "  pm.collectionVariables.unset('csrfToken');",
                  "}",
                  "if (pm.response.code === 200) pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05 Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"mfaCode\": \"{{adminMfaCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in the bootstrapped admin with the current six-digit TOTP code. Successful login rotates JSESSIONID and CSRF. Run 06 Refresh CSRF next."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrfToken')) throw new Error('Run 01 Get CSRF first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Role is ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));",
                  "  pm.collectionVariables.unset('csrfToken');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "06 Refresh CSRF After Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf",
            "description": "Fetches the new CSRF token bound to the authenticated session after session fixation protection rotates the session ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const csrf = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', csrf.token);",
                  "pm.collectionVariables.set('csrfHeader', csrf.headerName);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "07 Current Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Returns the account represented by the current JSESSIONID session. Expected status: 200 when logged in, 401 otherwise."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Account has id and role', () => { const account = pm.response.json(); pm.expect(account.id).to.be.a('string'); pm.expect(account.role).to.be.a('string'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "08 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Invalidates the server-side session and deletes JSESSIONID. Requires the current CSRF token. Expected status: 204."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrfToken')) throw new Error('Fetch or refresh CSRF first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) pm.collectionVariables.unset('csrfToken');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Brand Panel",
      "description": "Requires an authenticated account with ROLE_BRAND.",
      "item": [
        {
          "name": "Get Own Brand",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/panel/brand"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('brandId', pm.response.json().id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Own Branches",
          "request": {
            "method": "GET",
