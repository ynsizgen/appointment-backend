          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 && pm.response.json().length) pm.collectionVariables.set('branchId', pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Open Appointment Acceptance",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/panel/branches/{{branchId}}/appointment-acceptance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acceptingAppointments\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Close Appointment Acceptance",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/panel/branches/{{branchId}}/appointment-acceptance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acceptingAppointments\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires an authenticated account with ROLE_ADMIN.",
      "item": [
        {
          "name": "List Brand Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Account Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"subscriptionActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
