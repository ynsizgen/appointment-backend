{
  "info": {
    "_postman_id": "4f696f5e-f218-4ab0-b8ce-838298f6f161",
    "name": "Appointment Platform Backend",
    "description": "Session authentication: Get CSRF, login, Refresh CSRF. Registration keeps its existing payload and creates account, Brand and first Branch on verification. Brand owners manage their branches; admins manage only account enabled/subscriptionActive states. Booking and payment integration are not implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
